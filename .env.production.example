# Sentrix dashboard — PRODUCTION environment template.
#
# IMPORTANT: unlike the backend, these values are baked into the JS bundle at
# BUILD TIME by Vite (see Dockerfile) — editing a running container's env
# does nothing. To change any of these in production you rebuild the image
# (CI does this automatically on push to main — see
# .github/workflows/deploy.yml). None of these are secrets; they're all
# public URLs/keys the browser calls directly, safe to see in devtools.

VITE_API_URL=https://api.sentrixglobaltech.com/api/v1
VITE_DEVICE_NAME=Sentrix Console (web)

# Reverb rides the same api.* origin as the REST API (Caddy routes the
# /app/{key} path to the reverb container — see ../Caddyfile). Match the
# backend's REVERB_APP_KEY exactly (that one IS meant to be public — it's
# how the client identifies which app to subscribe to, not a secret).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=api.sentrixglobaltech.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
