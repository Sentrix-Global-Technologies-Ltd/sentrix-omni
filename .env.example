# Sentrix Console (React dashboard) — environment
#
# The dashboard is a pure client of the Sentrix API, deployed on a SEPARATE
# origin. Point this at the running backend's versioned API base.
#
# Local Sail:          http://localhost/api/v1
# Behind `sail share`: https://<tunnel-host>/api/v1
VITE_API_URL=http://localhost/api/v1

# Sent as `device_name` on login so the backend issues a named Sanctum token.
VITE_DEVICE_NAME=Sentrix Console (web)

# NOTE: because the API is on a separate origin, the backend must allow this
# dashboard's origin via CORS (Allow-Origin + Authorization / X-Organization
# headers). See docs/AUTH.md.

# Realtime (Reverb / Pusher protocol). Match the backend's REVERB_* values.
# Optional: if unset, the app still works — realtime updates are simply disabled.
# Private-channel auth additionally requires the backend to expose
# /broadcasting/auth for bearer tokens + CORS (see docs/INCIDENT_WORKSPACE.md).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
